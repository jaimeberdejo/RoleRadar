# BuscadorDeEmpleo v2.0 — configuración de entorno.
# cp .env.example .env    y rellena los valores.
# NUNCA commitees el fichero .env.

# ── LLM (opcional en v2.0) ───────────────────────────────────────────────────
# Scoring funciona 100% local (BGE-M3 + reglas) sin esta clave.
# Si se define: añade reasons_for/reasons_against y matched/missing skills.
# OPENAI_API_KEY=sk-proj-...

# Modelos opcionales (defaults en código):
# OPENAI_MODEL_CV=gpt-4o-mini
# OPENAI_MODEL_SCORING=gpt-4o

# ── Persistencia ─────────────────────────────────────────────────────────────
# SQLite local. Ruta opcional — default: data/jobs.db (relativo al CWD).
# SQLITE_DB_PATH=data/jobs.db

# ── Fuentes de empleo ────────────────────────────────────────────────────────
# JSearch via RapidAPI. Requerida para que el worker busque ofertas.
# IMPORTANTE: rotar la clave anterior en https://rapidapi.com si la clave
# anterior estuvo expuesta. Ver STATE.md blocker MIG-03.
# RAPIDAPI_KEY=

# ── Notificaciones Telegram (opcional — Fase 9) ───────────────────────────────
# Si se definen ambas vars, el digest de nuevas ofertas se envía por Telegram.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Notificaciones email SMTP (opcional — Fase 9) ────────────────────────────
# Fallback si no hay Telegram. Ambas vars (HOST + credenciales) requeridas.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=

# ── Observabilidad Langfuse (opcional) ───────────────────────────────────────
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
