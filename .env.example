# Configuración del proyecto.  cp .env.example .env
# Clave de OpenAI para parseo de CV y scoring. Requerida.
OPENAI_API_KEY=sk-proj-...

# Modelos opcionales (tienen defaults sensatos en código):
# OPENAI_MODEL_CV=gpt-4o-mini
# OPENAI_MODEL_SCORING=gpt-4o

# Persistencia: SQLite local (default). Ruta opcional del fichero:
# SQLITE_DB_PATH=data/jobs.db

# Observabilidad opcional (OBS-02) — activa el tracing de las llamadas LLM con Langfuse:
# Instalar primero: uv add langfuse
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# Autenticación por API Key (opcional pero recomendada en producción).
# Si API_KEY está vacía o ausente → la autenticación está DESACTIVADA (útil en dev/tests).
# Si API_KEY está configurada → todas las rutas exigen la cabecera X-API-Key,
# excepto GET /health. Para generar una clave segura:
#   openssl rand -hex 32
# API_KEY=
